        {
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "format": "table",
          "rawSql": "SELECT CONCAT(COUNT(DISTINCT sr.node_id), ' zone(s) need attention — ', GROUP_CONCAT(DISTINCT CONCAT(sn.position, ' (', sr.clr_risk, ')') SEPARATOR ', ')) AS value FROM sensor_readings sr INNER JOIN (SELECT node_id, MAX(recorded_at) AS latest FROM sensor_readings GROUP BY node_id) l ON sr.node_id = l.node_id AND sr.recorded_at = l.latest LEFT JOIN sensor_nodes sn ON sr.node_id = sn.node_id WHERE sr.clr_risk = 'HIGH' OR sr.soil_pct < 30",
          "refId": "A"
        }
      ],
      "title": "⚠️ URGENT ALERTS",
