      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "format": "table",
          "rawSql": "SELECT sn.position AS 'Zone', CASE WHEN sr.clr_risk = 'HIGH' AND sr.soil_pct < 35 THEN '🚨 URGENT: DO NOT WATER this zone. Disease risk is HIGH. Check leaf undersides for yellow-orange spots. Report any findings to supervisor immediately.' WHEN sr.clr_risk = 'HIGH' THEN '🚨 URGENT: Disease risk HIGH. Walk through zone and look for yellow spots on leaves. Take photos of suspicious leaves. Do NOT water.' WHEN sr.soil_pct < 30 THEN '👷 ACTION: Drip irrigation is ON. Soil is very dry. Check drip lines for clogs. Monitor for 2 hours then report.' WHEN sr.soil_pct < 35 THEN '👷 ACTION: Prepare to water. If soil gets drier, irrigation will start automatically. Check weather — if rain expected, wait.' WHEN sr.clr_risk = 'MODERATE' THEN '⚠️ WATCH: Conditions may worsen. Walk through zone during next check. Look for any unusual leaf spots. Report anything unusual.' ELSE '✅ ALL GOOD: Continue regular monitoring. Check plants for pests. Remove fallen leaves from ground. Next check in 4 hours.' END AS 'What To Do', CASE WHEN sr.soil_pct < 30 THEN '💧 Very Dry' WHEN sr.soil_pct < 35 THEN '💧 Needs Water' ELSE '✓ Good' END AS 'Soil Water', CASE WHEN sr.clr_risk = 'HIGH' THEN '🦠 HIGH' WHEN sr.clr_risk = 'MODERATE' THEN '⚠️ WATCH' ELSE '✓ Safe' END AS 'Disease Risk', CASE WHEN sr.soil_pct < 35 AND sr.clr_risk != 'HIGH' THEN '💧 ON' WHEN sr.clr_risk = 'HIGH' THEN '🚫 STOP' ELSE '⏸ OFF' END AS 'Water Valve' FROM sensor_readings sr INNER JOIN (SELECT node_id, MAX(recorded_at) AS latest FROM sensor_readings GROUP BY node_id) l ON sr.node_id = l.node_id AND sr.recorded_at = l.latest LEFT JOIN sensor_nodes sn ON sr.node_id = sn.node_id ORDER BY FIELD(sr.clr_risk, 'HIGH', 'MODERATE', 'LOW'), sr.node_id",
          "refId": "A"
        }
      ],
      "title": "👷 Detailed Action Instructions per Zone",
      "type": "table"
    },
