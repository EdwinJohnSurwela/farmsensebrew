        {
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "format": "table",
          "rawSql": "SELECT sr.node_id AS 'Node', sn.position AS 'Position', sr.temperature AS 'Temp (°C)', sr.humidity AS 'Humidity (%)', sr.soil_pct AS 'Soil (%)', sr.clr_risk AS 'CLR Risk', sr.recorded_at AS 'Last Reading' FROM sensor_readings sr INNER JOIN (SELECT node_id, MAX(recorded_at) AS latest FROM sensor_readings GROUP BY node_id) l ON sr.node_id = l.node_id AND sr.recorded_at = l.latest LEFT JOIN sensor_nodes sn ON sr.node_id = sn.node_id ORDER BY sr.node_id",
          "refId": "A"
        }
      ],
      "title": "Latest Readings per Node",
      "type": "table"
