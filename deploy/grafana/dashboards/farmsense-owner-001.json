          "rawSql": "SELECT $__timeGroupAlias(recorded_at, '1h'), ROUND(AVG(temperature), 1) AS `Temperature (°C)`, ROUND(AVG(humidity), 0) AS `Humidity (%)` FROM sensor_readings WHERE $__timeFilter(recorded_at) GROUP BY 1 ORDER BY 1"
