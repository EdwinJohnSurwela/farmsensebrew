        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Nodes at High or Critical",
      "description": "Online nodes whose latest reading is High or Critical CLR risk.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM sensor_nodes sn JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1 AND (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) AND lr.clr_risk IN ('HIGH', 'CRITICAL')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22C55E",
                "value": null
              },
              {
                "color": "#EF4444",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
