    {
      "id": 14,
      "type": "gauge",
      "title": "Farm CLR risk score",
      "description": "Average CLR score (0 to 100) of the online nodes. Bands: 0-20 Minimal, 21-40 Low, 41-60 Moderate, 61-80 High, 81-100 Critical.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT ROUND(AVG(lr.confidence_pct), 0) AS value FROM sensor_nodes sn JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1 AND (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "noValue": "Waiting for readings",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22C55E",
                "value": null
              },
              {
                "color": "#84CC16",
                "value": 21
              },
              {
                "color": "#F59E0B",
                "value": 41
              },
              {
                "color": "#F97316",
                "value": 61
              },
              {
                "color": "#EF4444",
                "value": 81
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Nodes online",
      "description": "Online = the box is sending data right now (same as the web app).",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT SUM(CASE WHEN lr.id IS NOT NULL AND (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN 1 ELSE 0 END) AS `Online`, COUNT(*) AS `Registered` FROM sensor_nodes sn LEFT JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Waiting for readings",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3B82F6",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Online"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#22C55E"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Registered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9CA3AF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
