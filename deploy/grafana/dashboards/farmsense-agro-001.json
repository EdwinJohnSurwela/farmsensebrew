          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CONCAT('Node ', CAST(SUBSTRING(sn.node_id, 6) AS UNSIGNED), ' · ', CASE sn.position WHEN 'NW_CORNER' THEN 'NW' WHEN 'NE_CORNER' THEN 'NE' WHEN 'CENTER' THEN 'Centre' WHEN 'SW_CORNER' THEN 'SW' WHEN 'SE_CORNER' THEN 'SE' ELSE sn.position END) AS `Node`, CASE WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) AND ((lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) AND lr.air_ok = 0 AND lr.soil_ok = 0) THEN 'Both sensors not reading' WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) THEN 'Offline' WHEN lr.temperature IS NULL THEN 'DHT22 problem' WHEN lr.clr_risk = 'CRITICAL' THEN 'Critical' WHEN lr.clr_risk = 'HIGH' THEN 'High' WHEN lr.clr_risk = 'MODERATE' THEN 'Moderate' WHEN lr.clr_risk = 'LOW' THEN 'Low' ELSE 'Minimal' END AS `Status`, CASE WHEN (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN lr.temperature END AS `Temp`, CASE WHEN (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN lr.humidity END AS `Humidity`, CASE WHEN (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN lr.soil_pct END AS `Soil`, CASE WHEN (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN lr.confidence_pct END AS `CLR score`, UNIX_TIMESTAMP(lr.recorded_at) * 1000 AS `Last reading` FROM sensor_nodes sn LEFT JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1 ORDER BY sn.node_id"
