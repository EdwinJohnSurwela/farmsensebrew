    {
      "id": 5,
      "type": "stat",
      "title": "Node status",
      "description": "Colour = CLR risk of the node's latest reading. Grey = the box is not sending data.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CONCAT('Node ', CAST(SUBSTRING(sn.node_id, 6) AS UNSIGNED), ' · ', CASE sn.position WHEN 'NW_CORNER' THEN 'NW' WHEN 'NE_CORNER' THEN 'NE' WHEN 'CENTER' THEN 'Centre' WHEN 'SW_CORNER' THEN 'SW' WHEN 'SE_CORNER' THEN 'SE' ELSE sn.position END) AS node, CASE WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) AND ((lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) AND lr.air_ok = 0 AND lr.soil_ok = 0) THEN 6 WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) THEN 0 WHEN lr.temperature IS NULL THEN 7 WHEN lr.clr_risk = 'CRITICAL' THEN 5 WHEN lr.clr_risk = 'HIGH' THEN 4 WHEN lr.clr_risk = 'MODERATE' THEN 3 WHEN lr.clr_risk = 'LOW' THEN 2 ELSE 1 END AS status FROM sensor_nodes sn LEFT JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1 ORDER BY sn.node_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No nodes registered",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#9CA3AF",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "#9CA3AF",
                  "index": 0
                },
                "1": {
                  "text": "Minimal",
                  "color": "#22C55E",
                  "index": 1
                },
                "2": {
                  "text": "Low",
                  "color": "#84CC16",
                  "index": 2
                },
                "3": {
                  "text": "Moderate",
                  "color": "#F59E0B",
                  "index": 3
                },
                "4": {
                  "text": "High",
                  "color": "#F97316",
                  "index": 4
                },
                "5": {
                  "text": "Critical",
                  "color": "#EF4444",
                  "index": 5
                },
                "6": {
                  "text": "Both sensors not reading",
                  "color": "#6B21A8",
                  "index": 6
                },
                "7": {
                  "text": "DHT22 problem",
                  "color": "#6B21A8",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^status$/"
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
