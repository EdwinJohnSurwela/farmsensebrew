    {
      "id": 11,
      "type": "bargauge",
      "title": "Hours in the rust range",
      "description": "Time each node spent at 21 to 25 °C with humidity above 80 % in the selected period (5-minute slots).",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CONCAT('Node ', CAST(SUBSTRING(sn.node_id, 6) AS UNSIGNED), ' · ', CASE sn.position WHEN 'NW_CORNER' THEN 'NW' WHEN 'NE_CORNER' THEN 'NE' WHEN 'CENTER' THEN 'Centre' WHEN 'SW_CORNER' THEN 'SW' WHEN 'SE_CORNER' THEN 'SE' ELSE sn.position END) AS node, IFNULL(ROUND(x.slots * 5 / 60, 1), 0) AS hours FROM sensor_nodes sn LEFT JOIN (SELECT node_id, COUNT(DISTINCT FLOOR(UNIX_TIMESTAMP(recorded_at) / 300)) AS slots FROM sensor_readings WHERE $__timeFilter(recorded_at) AND temperature BETWEEN 21 AND 25 AND humidity > 80 GROUP BY node_id) x ON x.node_id = sn.node_id WHERE sn.is_active = 1 ORDER BY sn.node_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "min": 0,
          "max": 24,
          "noValue": "Waiting for readings",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F59E0B",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
