    {
      "id": 26,
      "type": "table",
      "title": "Registered nodes",
      "description": "A node posting every 5 minutes sends 288 readings a day.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CONCAT('Node ', CAST(SUBSTRING(sn.node_id, 6) AS UNSIGNED), ' · ', CASE sn.position WHEN 'NW_CORNER' THEN 'NW' WHEN 'NE_CORNER' THEN 'NE' WHEN 'CENTER' THEN 'Centre' WHEN 'SW_CORNER' THEN 'SW' WHEN 'SE_CORNER' THEN 'SE' ELSE sn.position END) AS `Node`, sn.node_id AS `ID`, CASE WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) AND ((lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) AND lr.air_ok = 0 AND lr.soil_ok = 0) THEN 'Both sensors not reading' WHEN (lr.id IS NULL OR NOT (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) OR (lr.air_ok = 0 AND lr.soil_ok = 0)) THEN 'Offline' WHEN lr.temperature IS NULL THEN 'DHT22 problem' WHEN lr.clr_risk = 'CRITICAL' THEN 'Critical' WHEN lr.clr_risk = 'HIGH' THEN 'High' WHEN lr.clr_risk = 'MODERATE' THEN 'Moderate' WHEN lr.clr_risk = 'LOW' THEN 'Low' ELSE 'Minimal' END AS `Status`, UNIX_TIMESTAMP(lr.recorded_at) * 1000 AS `Last reading`, (SELECT COUNT(*) FROM sensor_readings r WHERE r.node_id = sn.node_id AND r.recorded_at >= NOW() - INTERVAL 24 HOUR) AS `Readings (24 h)`, sn.installed_at AS `Installed` FROM sensor_nodes sn LEFT JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1 ORDER BY sn.node_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Nothing yet",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Offline": {
                        "color": "#9CA3AF",
                        "index": 0
                      },
                      "Minimal": {
                        "color": "#22C55E",
                        "index": 1
                      },
                      "Low": {
                        "color": "#84CC16",
                        "index": 2
                      },
                      "Moderate": {
                        "color": "#F59E0B",
                        "index": 3
                      },
                      "High": {
                        "color": "#F97316",
                        "index": 4
                      },
                      "Critical": {
                        "color": "#EF4444",
                        "index": 5
                      },
                      "Both sensors not reading": {
                        "color": "#6B21A8",
                        "index": 6
                      },
                      "DHT22 problem": {
                        "color": "#6B21A8",
                        "index": 7
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
