    {
      "id": 28,
      "type": "table",
      "title": "Sensor faults",
      "description": "A sensor that gave no good value for 1 minute while its box was on. Open faults stay at the top until the sensor reads again.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CONCAT('Node ', CAST(SUBSTRING(f.node_id, 6) AS UNSIGNED)) AS `Node`, CASE f.sensor WHEN 'air' THEN 'DHT22 (temperature and humidity)' ELSE 'Capacitive soil moisture sensor' END AS `Sensor`, UNIX_TIMESTAMP(f.started_at) * 1000 AS `Stopped`, UNIX_TIMESTAMP(f.ended_at) * 1000 AS `Came back`, CASE WHEN f.ended_at IS NULL THEN 'Still not reading' ELSE CONCAT(TIMESTAMPDIFF(MINUTE, f.started_at, f.ended_at), ' min') END AS `Out for` FROM node_sensor_faults f WHERE f.ended_at IS NULL OR $__timeFilter(f.started_at) ORDER BY f.ended_at IS NULL DESC, f.started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No sensor faults",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Stopped"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Came back"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "noValue",
                "value": "Not yet"
              }
            ]
          },
          {
