    {
      "id": 27,
      "type": "timeseries",
      "title": "Readings received per hour",
      "description": "12 per hour per node is complete at 5-minute posting.",
      "datasource": {
        "type": "mysql",
        "uid": "fflcm0ubrdqtcf"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(recorded_at, '1h'), CONCAT('Node ', CAST(SUBSTRING(node_id, 6) AS UNSIGNED)) AS metric, COUNT(*) AS value FROM sensor_readings WHERE $__timeFilter(recorded_at) GROUP BY 1, 2 ORDER BY 1"
