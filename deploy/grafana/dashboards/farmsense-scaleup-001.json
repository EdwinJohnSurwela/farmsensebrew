        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "fflcm0ubrdqtcf"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS `Registered`, SUM(CASE WHEN lr.id IS NOT NULL AND (lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND) THEN 1 ELSE 0 END) AS `Online`, SUM(CASE WHEN lr.id IS NULL OR NOT ((lr.online = 1 AND lr.updated_at >= NOW() - INTERVAL 15 SECOND)) THEN 1 ELSE 0 END) AS `Offline` FROM sensor_nodes sn LEFT JOIN (SELECT node_id, 1 AS id, online, air_ok, soil_ok, temperature, humidity, soil_pct, clr_risk, confidence_pct, COALESCE(values_at, last_seen) AS recorded_at, updated_at FROM node_live) lr ON lr.node_id = sn.node_id WHERE sn.is_active = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Waiting for readings",
